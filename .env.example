# Copy this file to .env and replace development secrets before use.

# PostgreSQL
POSTGRES_USER=dw_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
RETAIL_DB=retail_dw
AIRFLOW_DB=airflow_db
POSTGRES_HOST_PORT=5433

# Local ETL connection
DB_HOST=localhost
DB_PORT=5433

# Airflow
AIRFLOW_PORT=8081
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_FIRSTNAME=admin
AIRFLOW_ADMIN_LASTNAME=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_PASSWORD=change-me

# pgAdmin
PGADMIN_PORT=5051
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Superset
SUPERSET_PORT=8089
SUPERSET_SECRET_KEY=replace-with-a-long-random-secret
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_FIRSTNAME=admin
SUPERSET_ADMIN_LASTNAME=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_PASSWORD=change-me
